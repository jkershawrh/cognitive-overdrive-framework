{
  "name": "cognitive-overdrive-framework",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:visual": "playwright test",
    "verify:offline": "node scripts/verify-offline.mjs",
    "check": "npm run validate:story && npm run test && npm run build && npm run verify:offline",
    "preview": "vite preview",
    "validate:story": "node scripts/validate-story.mjs",
    "render:video": "node scripts/render-frames.mjs",
    "build:film": "node scripts/build-cinematic-timeline.mjs",
    "mix:audio": "python3 scripts/mix-audio.py",
    "render:legacy": "node scripts/render-video.mjs",
    "assemble:video": "node scripts/assemble-film.mjs",
    "verify:film-media": "node scripts/verify-frame-media.mjs",
    "render:diagnostic": "node scripts/render-cinematic.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  },
  "description": "Reusable narrative demo framework with a Cognitive Overdrive portfolio story package.",
  "engines": {
    "node": ">=22.12.0"
  }
}
